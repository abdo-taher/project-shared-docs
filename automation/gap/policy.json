    "import",
    "export",
    "exchange",
    "integration"
  ],
  "development": {
    "forge": "github",
    "repository": "abdo-taher/capitalix",
    "remote": "git@github.com:abdo-taher/capitalix.git",
    "base_branch": "integration/E01-FOUNDATION-SAAS",
    "review_base": "integration/E01-FOUNDATION-SAAS"
  },
  "agent_workflow": [
    "Read AGENTS.md and docs/implementation/EXECUTOR_BRIEF.md first and follow the project rules (attribute routing, modular boundaries, no migrations).",
    "If vendor/ is missing run `composer install --no-interaction --prefer-dist --no-scripts`, then `cp -n .env.example .env && php artisan key:generate --force`; vendor/ and .env stay untracked.",
    "Implement the smallest correct fix with PHPUnit tests under tests/ (follow the neighbouring tests) and run only your tests: `php vendor/bin/phpunit <your test file>`.",
    "Verify the contract WITHOUT committing it: `env DB_CONNECTION=sqlite DB_DATABASE=:memory: php artisan openapi:generate --path=/tmp/gap-openapi.json`. docs/api/openapi.json is generated by the gates in this repository: never commit it.",
    "Check your evidence against that contract: `python3 /opt/gap-tools/check_resolutions.py --dir docs/api-gap/resolutions --contract /tmp/gap-openapi.json`."
  ],
  "agent_sandbox": {
    "enabled": true,
    "image": "capitalix-gap-agent:2",
    "memory": "4g",
    "cpus": "2"
  },
  "coordination": {
    "required": true,
    "default_repo": "~/projects/capitalix",
    "actor_roots": {
      "owner": [
        "app/ERP/Capabilities/OwnerApi"
      ],
      "admin": [
        "app/ERP/Capabilities/Admin"
      ]
    },
    "operation_roots": {
      "owner.": [
        "app/ERP/Capabilities/OwnerApi"
      ],
      "admin.": [
        "app/ERP/Capabilities/Admin"
      ]
    },
    "lease_slack_seconds": 600,
    "always_allowed": [
      "tests/",
      "docs/api-gap/resolutions/"
    ]
  },
  "protected_paths_extra": [
    "database/migrations/",
    "docs/api/openapi.json"
  ],
  "verification": {
    "require_tests": true,
    "timeout_seconds": 900,
    "commands": [
      "env DB_CONNECTION=sqlite DB_DATABASE=:memory: php artisan openapi:generate --path=/tmp/gap-openapi.json",
      "python3 /opt/gap-tools/check_resolutions.py --dir docs/api-gap/resolutions --contract /tmp/gap-openapi.json",
      "php vendor/bin/phpunit {tests}"
    ]
  },
  "evidence": {
    "require_failing_on_published": true
  },
  "backend_repository": "abdo-taher/capitalix",
  "owner_usernames": [
    "abdo-taher"
  ],
  "publication_proof": "contract-evidence"
}
