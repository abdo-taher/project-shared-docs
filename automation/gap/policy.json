  "sensitive_gap_types": [
    "AUTH_MISMATCH",
    "BUSINESS_RULE_GAP"
  ],
  "dispatch_min_access_level": 30,
  "public_backend_reference": true,
  "resolution_dir": "docs/api-gap/resolutions",
  "max_attempts": 5,
  "stale_after_days": 14,
  "sensitive_keywords": [
    "accounting",
    "journal",
    "ledger",
    "reconcil",
    "financial",
    "tax",
    "vat",
    "zakat",
    "payroll",
